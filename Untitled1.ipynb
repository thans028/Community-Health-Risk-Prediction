import matplotlib.pyplot as plt
import numpy as np

# Compare actual and predicted diabetes prevalence
plt.figure(figsize=(8, 6))

plt.scatter(y_test, y_pred, alpha=0.6)

# Ideal prediction line
min_value = min(y_test.min(), y_pred.min())
max_value = max(y_test.max(), y_pred.max())

plt.plot(
    [min_value, max_value],
    [min_value, max_value],
    linestyle="--",
    label="Perfect prediction"
)

plt.xlabel("Actual Diabetes Prevalence (%)")
plt.ylabel("Predicted Diabetes Prevalence (%)")
plt.title("Actual vs. Predicted Diabetes Prevalence")
plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()

plt.savefig("actual-vs-predicted.png", dpi=300)
plt.show()
